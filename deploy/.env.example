# Скопируй в deploy/.env (в git не коммитится) и подставь реальные значения.
# JWT_SECRET — секрет подписи токенов. Генерация: openssl rand -hex 24
JWT_SECRET=replace-me-openssl-rand-hex-24
# NEXT_PUBLIC_API_URL — публичный адрес API (зашивается в app при сборке). Напр. https://api.jooz.example
NEXT_PUBLIC_API_URL=https://api.example.dev
