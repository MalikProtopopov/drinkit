# grabzi-web (актуальный публичный фронт) — тонкий рантайм поверх локально собранного
# Next standalone-бандла (deploy/web). next build на сервере не запускаем (мало RAM).
FROM node:22-alpine
WORKDIR /srv
COPY web/ ./
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["node", "server.js"]
